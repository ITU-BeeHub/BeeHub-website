# Configuration of the BeeHub website API and its database, installed as
# /etc/beehub/env. It holds secrets, so keep it readable by root and the
# deploy user only:
#   sudo install -m 640 -o root -g "$USER" deploy/env.example /etc/beehub/env
# Commented lines show the defaults.

# HTTP
HTTP_ADDR=127.0.0.1:9000
PUBLIC_URL=https://beehubapp.com
# TRUSTED_PROXIES=127.0.0.1,::1
# SWAGGER_ENABLED=false

# Release served by /api/download and reported by /api/version.
# Installers are read from $INSTALLERS_DIR/installer_<version>.{exe,dmg}.
APP_VERSION=1.2.1
INSTALLERS_DIR=/opt/beehub/installers
# DOWNLOAD_DEDUP_WINDOW=10m
# COUNTRY_HEADER=CF-IPCountry
# STATS_TIMEZONE=Europe/Istanbul

# Admin sessions. Generate the secret with: openssl rand -base64 48
JWT_SECRET=
# JWT_TTL=6h

# Database, also used by deploy/compose.yaml to initialize PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5429
DB_NAME=beehub
DB_USER=beehub
DB_PASSWORD=
# DB_SSLMODE=disable
# DB_CONNECT_TIMEOUT=1m
