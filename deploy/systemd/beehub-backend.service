[Unit]
Description=BeeHub website API
Documentation=https://github.com/ITU-BeeHub/BeeHub-website
Wants=network-online.target
# The database runs in Docker; the API also retries until it is reachable.
After=network-online.target docker.service snap.docker.dockerd.service

[Service]
Type=exec
ExecStart=/opt/beehub/bin/beehub-web
EnvironmentFile=/etc/beehub/env
Restart=always
RestartSec=5s
TimeoutStopSec=20s

# The API only reads its binary and the installers and logs to the journal,
# so it runs as a throwaway user with a read-only view of the system.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
